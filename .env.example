# Copie para .env e preencha. NUNCA suba o .env para o GitHub.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Voz do ElevenLabs (troque por uma voz brasileira da Voice Library, ex.: busque "Brazilian Portuguese")
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_flash_v2_5

LLM_MODEL=claude-haiku-4-5

# Ajuste fino de latência
DEEPGRAM_ENDPOINTING_MS=300
DEEPGRAM_UTTERANCE_END_MS=1000

# true = pode interromper o agente falando (use fone). false = half-duplex (caixa de som).
BARGE_IN=true
